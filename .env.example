# Copiez ce fichier vers .env et renseignez vos valeurs
# cp .env.example .env

# ── Gmail (mot de passe d'application Google) ──
GMAIL_ADDRESS=votre.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Airtable CRM ──
# https://airtable.com/create/tokens
# Scopes requis : schema.bases:read, schema.bases:write, data.records:read, data.records:write
AIRTABLE_API_KEY=patXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXX
AIRTABLE_TABLE_CONTACTS=Contacts

# ── OpenAI (classification optionnelle) ──
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Brevo (newsletter) ──
BREVO_API_KEY=xkeysib-...
BREVO_LIST_PROFESSEURS=1
BREVO_LIST_ENTREPRISES=2

# ── Webhooks n8n (optionnel) ──
N8N_WEBHOOK_GMAIL_SYNC=https://votre-n8n.com/webhook/gmail-sync
N8N_WEBHOOK_NEW_LEAD=https://votre-n8n.com/webhook/new-lead

# ── Scoring ──
SCORE_MIN_PROFESSIONAL=10
SKIP_PERSONAL_DOMAINS=gmail.com,yahoo.com,hotmail.com,outlook.com,icloud.com,proton.me
